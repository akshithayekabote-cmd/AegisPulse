
# Python cache files
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/

# IDE settings
.vscode/

# Jupyter files
.ipynb_checkpoints/

# Temporary and operating system files
*.log
*.tmp
.DS_Store
Thumbs.db

# Raw datasets
data/raw/

# Ignore generated processed files by default
data/processed/*

# Keep essential files required by AegisPulse
!data/processed/india_grid_subdivision_mapping.csv
!data/processed/india_rainfall_cleaned_2015_2024.nc
!data/processed/spatial_neighbor_mapping.npz

# Keep prediction output
!data/processed/predictions/
data/processed/predictions/*
!data/processed/predictions/aegispulse_next_day_predictions.csv.gz

# Keep only the final frozen model
models/*
!models/historical_rainfall_model_v3.npz
